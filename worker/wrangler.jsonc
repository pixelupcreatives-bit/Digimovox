{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movox-admin-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "beyonddigital" }
  ]
}
