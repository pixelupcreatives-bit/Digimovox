# MovoX Website Environment Variables
# Copy this file to .env and fill in your values.

# Site configuration
VITE_SITE_URL=https://www.heymovox.com
VITE_SITE_NAME=MovoX

# Form submission backend (optional)
# Leave unset to use the local integration boundary (no live submission).
VITE_FORM_ENDPOINT=

# Start a Project enquiry API (optional)
# Full URL of the enquiry endpoint that accepts POST JSON from the
# /start-a-project wizard (contract documented in src/lib/enquiryApi.ts).
# When unset the wizard runs in DEMO MODE: nothing is stored or sent, and the
# UI tells the user their enquiry was not actually submitted.
# Expected response: 200/201 { ok: true, referenceId } | 409 duplicate | 429 rate-limited
VITE_ENQUIRY_ENDPOINT=

# Optional bearer token for the enquiry API. Read at runtime and visible to
# browsers, so do NOT put a secret here — restrict access by origin / rate
# limit on the server instead.
VITE_ENQUIRY_API_KEY=

# Email notification / form service (optional)
VITE_EMAIL_SERVICE_KEY=

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=

# ReCAPTCHA site key for spam protection (optional)
VITE_RECAPTCHA_SITE_KEY=

# Admin API (Cloudflare Worker) — optional
# Leave unset in development to use the Vite proxy (/api → wrangler dev on :8787).
# In production set this to the deployed Worker URL (no trailing slash),
# e.g. https://movox-admin-api.<subdomain>.workers.dev
VITE_API_URL=
